<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<OutputType>Exe</OutputType>
	<IsPackable>false</IsPackable>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
		<!-- Disable Microsoft Testing Platform runner to avoid runtime MTP extension type conflicts -->
	  <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
	  <TestingPlatformDotnetTestSupport>false</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
	<PackageReference Include="coverlet.collector" Version="4.*" />
	<!-- coverlet.MTP removed to avoid Microsoft Testing Platform extension version conflicts -->
	<PackageReference Include="xunit.runner.visualstudio" Version="3.*" />
	<PackageReference Include="xunit.v3" Version="3.2.2" />
	<PackageReference Include="Moq" Version="4.20.72" />
	<PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.102.1" />
	<PackageReference Include="Amazon.Lambda.Core" Version="3.2.0" />
	<PackageReference Include="Amazon.Lambda.APIGatewayEvents" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\..\AccountProcessingLambda\AccountProcessingLambda.csproj" />
  </ItemGroup>
</Project>
